datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  OFFICER      // เจ้าหน้าที่ประจำคณะ (สร้าง/จัดหลักสูตร, ยืนยันผลคัดเลือก)
  TEACHER      // อาจารย์/กรรมการ (ดูรายชื่อผู้สมัคร, กดคัดเลือกผู้ผ่านเกณฑ์)
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FLAGGED
}

enum ApplicationStatus {
  PENDING      // รอดำเนินการ
  ELIGIBLE     // ระบบคำนวณว่า "ผ่านเกณฑ์ขั้นต่ำ"
  INELIGIBLE   // ระบบคำนวณว่า "ไม่ผ่านเกณฑ์ขั้นต่ำ"
  PASSED       // อาจารย์กดเลือก "คัดเลือกผ่าน" (นับเข้า capacity)
  CONFIRMED    // เจ้าหน้าที่ประจำคณะกดยืนยันผลส่งมหาวิทยาลัย
  CANCELLED    // ยกเลิก
}

// ----------------------------------------------------
// MODELS (9 TABLES)
// ----------------------------------------------------

// 1. D1: Users (สำหรับผู้ดูแลระบบ เจ้าหน้าที่ และ อาจารย์)
model User {
  Usersid      String      @id @default(uuid()) @map("Usersid")
  email        String      @unique
  teacherId    String?     @unique
  password     String
  name         String
  role         Role        @default(OFFICER)

  universityId String?
  university   University? @relation(fields: [universityId], references: [Universitiesid])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  auditLogs    AuditLog[]

  @@map("D1_Users")
}

// 2. D2: Schools
model School {
  Schoolsid String    @id @default(uuid()) @map("Schoolsid")
  code      String    @unique
  name      String
  province  String
  students  Student[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("D2_Schools")
}

// 3. D3: Students
model Student {
  Studentsid         String             @id @default(uuid()) @map("Studentsid")
  schoolId           String?
  school             School?            @relation(fields: [schoolId], references: [Schoolsid])

  studentCode        String?
  nationalId         String             @unique
  name               String

  gpax               Float?
  mathGpa            Float?
  sciGpa             Float?
  engGpa             Float?
  thaiGpa            Float?
  socialGpa          Float?
  healthGpa          Float?
  artGpa             Float?
  careerGpa          Float?

  verificationStatus VerificationStatus @default(PENDING)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tcasScores         TcasScore?
  applications       Application[]
  auditLogs          AuditLog[]

  @@map("D3_Students")
}

// 4. D4: Tcas_Scores
model TcasScore {
  Tcas_Scoresid String   @id @default(uuid()) @map("Tcas_Scoresid")
  studentId     String   @unique
  student       Student  @relation(fields: [studentId], references: [Studentsid], onDelete: Cascade)

  tgat          Float?
  tpat1         Float?
  tpat2         Float?
  tpat3         Float?
  tpat4         Float?
  tpat5         Float?

  alevelMath1   Float?
  alevelMath2   Float?
  alevelSci     Float?
  alevelPhy     Float?
  alevelChem    Float?
  alevelBio     Float?
  alevelSoc     Float?
  alevelThai    Float?
  alevelEng     Float?
  alevelForeign Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("D4_Tcas_Scores")
}

// 5. D5: Universities
model University {
  Universitiesid String            @id @default(uuid()) @map("Universitiesid")
  code           String
  name           String
  campus         String
  faculty        String
  department     String

  users          User[]
  criteria       ProgramCriteria[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("D5_Universities")
}

// 6. D6: ProgramCriteria
model ProgramCriteria {
  Program_Criteriaid     String        @id @default(uuid()) @map("Program_Criteriaid")
  universityId           String
  university             University    @relation(fields: [universityId], references: [Universitiesid])
  isOpen                 Boolean       @default(true)
  programName            String

  // เกรดเฉลี่ยขั้นต่ำ
  minGpax                Float?
  minMathGpa             Float?
  minSciGpa              Float?
  minEngGpa              Float?
  minThaiGpa             Float?
  minSocialGpa           Float?
  minHealthGpa           Float?
  minArtGpa              Float?
  minCareerGpa           Float?

  // คะแนนสอบขั้นต่ำ (TGAT / TPAT)
  minTgat                Float?
  minTpat1               Float?
  minTpat2               Float?
  minTpat3               Float?
  minTpat4               Float?
  minTpat5               Float?

  // คะแนนสอบขั้นต่ำ (A-Level)
  minAlevelMath1         Float?
  minAlevelMath2         Float?
  minAlevelSci           Float?
  minAlevelPhy           Float?
  minAlevelChem          Float?
  minAlevelBio           Float?
  minAlevelSoc           Float?
  minAlevelThai          Float?
  minAlevelEng           Float?
  minAlevelForeign       Float?
  foreignLanguageSubject String?

  capacity               Int
  additionals            String?       @db.Text

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  applications           Application[]

  @@map("D6_Program_Criteria")
}

// 7. D7: Applications
model Application {
  Applicationsid      String               @id @default(uuid()) @map("Applicationsid")
  studentId           String
  student             Student              @relation(fields: [studentId], references: [Studentsid], onDelete: Cascade)

  criteriaId          String
  criteria            ProgramCriteria      @relation(fields: [criteriaId], references: [Program_Criteriaid])

  status              ApplicationStatus    @default(PENDING)
  remark              String?              @db.Text
  evaluatedAt         DateTime?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  facultyConfirmation FacultyConfirmation?

  @@unique([studentId, criteriaId])
  @@map("D7_Applications")
}

// 8. D8: AuditLogs
model AuditLog {
  AuditLogsid String   @id @default(uuid()) @map("AuditLogsid")
  action      String
  details     String?  @db.Text

  userId      String?
  user        User?    @relation(fields: [userId], references: [Usersid])

  studentId   String?
  student     Student? @relation(fields: [studentId], references: [Studentsid])

  createdAt   DateTime @default(now())

  @@map("D8_AuditLogs")
}

// 9. D9: FacultyConfirmations (ตารางใหม่: เก็บประวัติการยืนยันผลการคัดเลือก)
model FacultyConfirmation {
  FacultyConfirmationsid String      @id @default(uuid()) @map("FacultyConfirmationsid")
  applicationId          String      @unique
  application            Application @relation(fields: [applicationId], references: [Applicationsid], onDelete: Cascade)

  confirmedBy            String      // User ID ของผู้กดยืนยัน (อาจารย์/เจ้าหน้าที่)
  confirmedRole          Role        // บทบาทผู้กด (TEACHER หรือ OFFICER)
  note                   String?     @db.Text

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@map("D9_FacultyConfirmations")
}