datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  OFFICER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FLAGGED
}

enum ApplicationStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  CANCELLED
}

// ----------------------------------------------------
// MODELS (8 TABLES)
// ----------------------------------------------------

// 1. D1: Users (สำหรับ กรรมการ / ผู้ดูแลระบบ)
model User {
  id           String      @id @default(uuid())
  email        String      @unique // อีเมลมหาลัย (เช่น @ku.th)
  teacherId    String?     @unique // เลขประจำตัวอาจารย์/เจ้าหน้าที่
  password     String
  name         String
  role         Role        @default(OFFICER)
  
  universityId String?     // FK เชื่อมไปตาราง University
  university   University? @relation(fields: [universityId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  auditLogs    AuditLog[]
}

// 2. D2: Schools
model School {
  id        String    @id @default(uuid())
  code      String    @unique // รหัสโรงเรียน 10 หลัก
  name      String
  province  String
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 3. D3: Students (ข้อมูลนักเรียน และ ผลเกรดจาก OCR ปพ.1)
model Student {
  id                 String             @id @default(uuid())
  studentId          String             @unique // รหัสนักเรียน (ใช้ Login + เป็น Initial Password)
  nationalId         String             @unique // เลขประจำตัวประชาชน 13 หลัก
  name               String             // ชื่อ และนามสกุล
  gpax               Float              // เกรดเฉลี่ยสะสมรวม
  mathGpa            Float?             // เกรดกลุ่มสาระคณิตศาสตร์
  sciGpa             Float?             // เกรดกลุ่มสาระวิทยาศาสตร์
  engGpa             Float?             // เกรดกลุ่มสาระภาษาอังกฤษ
  transcriptUrl      String             // URL ไฟล์สแกน ปพ.1
  verificationStatus VerificationStatus @default(PENDING)
  isFirstLogin       Boolean            @default(true) // บังคับให้เปลี่ยนรหัสผ่านเมื่อ Login ครั้งแรก

  schoolId           String
  school             School             @relation(fields: [schoolId], references: [id])

  tcasScores         TcasScore?
  applications       Application[]
  auditLogs          AuditLog[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// 4. D4: Tcas_Scores
model TcasScore {
  id          String   @id @default(uuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tgat        Float?
  tpat2       Float?
  tpat3       Float?
  alevelMath1 Float?
  alevelSci   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 5. D5: Universities
model University {
  id         String            @id @default(uuid())
  code       String            @unique
  name       String            // เช่น มหาวิทยาลัยเกษตรศาสตร์
  campus     String            // เช่น วิทยาเขตบางเขน
  faculty    String            // เช่น คณะวิศวกรรมศาสตร์
  department String?           // ภาควิชา/สาขาวิชา (เช่น ภาควิชาพฤกษศาสตร์)
  
  users      User[]            // เชื่อมความสัมพันธ์กับตาราง User (อาจารย์)
  criteria   ProgramCriteria[]
  
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

// 6. D6: Program_Criteria
model ProgramCriteria {
  id             String        @id @default(uuid())
  programName    String        // เช่น สาขาวิชาวิทยาการคอมพิวเตอร์
  minGpax        Float         @default(0.0)
  minMathGpa     Float?
  minSciGpa      Float?
  minEngGpa      Float?
  minTgat        Float?
  minTpat2       Float?
  minTpat3       Float?
  minAlevelMath1 Float?        // คะแนนขั้นต่ำ A-Level Math 1
  minAlevelSci   Float?        // คะแนนขั้นต่ำ A-Level Sci
  capacity       Int           @default(0) // จำนวนที่รับ
  isOpen         Boolean       @default(true) // เพิ่ม: สถานะเปิด/ปิดรับสมัคร (เปิดเป็น default)
  
  universityId   String
  university     University    @relation(fields: [universityId], references: [id])
  
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// 7. D7: Applications (เชื่อม Student + ProgramCriteria + ผลประเมิน)
model Application {
  id          String            @id @default(uuid())
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  criteriaId  String
  criteria    ProgramCriteria   @relation(fields: [criteriaId], references: [id])
  
  status      ApplicationStatus @default(PENDING)
  remark      String?           @db.Text // เหตุผลประกอบ
  evaluatedAt DateTime?
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([studentId, criteriaId]) // สมัครสาขาเดิมซ้ำไม่ได้
}

// 8. D8: Audit_Logs
model AuditLog {
  id        String   @id @default(uuid())
  action    String   // เช่น "CORRECT_GRADE", "UPDATE_CRITERIA"
  details   String   @db.Text
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
  
  createdAt DateTime @default(now())
}